# 프론트 주소. 로그인 콜백 리다이렉트 대상 (Stage 1 에서 사용)
JANSPACE_FRONT_URL=
# 액세스 토큰 서명 비밀키 (HS256, 32바이트 이상). Stage 1 에서 사용
JANSPACE_JWT_SECRET=
# 네이버 OAuth2 클라이언트 ID (개발자센터 발급값)
NAVER_CLIENT_ID=
# 네이버 OAuth2 클라이언트 시크릿
NAVER_CLIENT_SECRET=
# 구글 OAuth2 클라이언트 ID (Cloud Console 발급값)
GOOGLE_CLIENT_ID=
# 구글 OAuth2 클라이언트 시크릿
GOOGLE_CLIENT_SECRET=
# 카카오 로컬 API REST 키 (국내 시군구 출발지 검색). 비어 있으면 한글 검색도 LocationIQ 로 간다
KAKAO_REST_API_KEY=
# LocationIQ 토큰 (해외 도시 출발지 검색)
LOCATIONIQ_TOKEN=
# S3 리전. 자격증명은 AWS SDK 기본 체인(EC2 IAM 역할)을 쓰므로 키를 두지 않는다
AWS_REGION=
# 포토카드 이미지 버킷 이름
AWS_S3_BUCKET=
# 이미지 공개 URL 의 CDN 기본 주소
CDN_BASE_URL=
# 디스코드 운영 알림 웹훅 URL (서버 설정 > 연동 > 웹훅). 비어 있으면 알림을 건너뛰고 로그만 남긴다
DISCORD_WEBHOOK_URL=
# DeepL API 키 (Free 플랜 엔드포인트). 행사·공연장 이름 번역 초안에 쓴다. 비어 있으면 초안을 만들지 않는다
DEEPL_API_KEY=
# setlist.fm API 키 (https://api.setlist.fm/docs). 셋리 병합·시드에 쓴다
SETLISTFM_API_KEY=
# 잔나비의 MusicBrainz 아티스트 ID. setlist.fm 아티스트 셋리 목록 조회에 쓴다
SETLISTFM_ARTIST_MBID=
# 유튜브 재생목록 OAuth 클라이언트 ID (Cloud Console, YouTube Data API v3 활성화)
YOUTUBE_CLIENT_ID=
# 유튜브 재생목록 OAuth 클라이언트 시크릿
YOUTUBE_CLIENT_SECRET=
# 이 API 서버의 공개 기본 주소. 유튜브 OAuth 콜백 redirect_uri ({API_BASE}/api/v1/admin/youtube/callback) 에 쓴다
JANSPACE_API_BASE_URL=
# 네이버 공개 캘린더(JANNABI SCHEDULE) publishedKey. 비공식 내부 API 용. 비우면 기획서의 공개 키를 쓴다
NAVER_CALENDAR_PUBLISHED_KEY=
# 네이버 공개 캘린더 ID. 비우면 기획서의 캘린더 ID 를 쓴다
NAVER_CALENDAR_ID=
# KOPIS(공연예술통합전산망) OpenAPI 서비스 키. 비어 있으면 KOPIS 보강을 건너뛴다
KOPIS_SERVICE_KEY=
# Ticketmaster Discovery API 키. 비어 있으면 Ticketmaster 동기화를 건너뛴다
TICKETMASTER_API_KEY=
# 웹 푸시 VAPID 키 쌍(P-256, base64url). `npx web-push generate-vapid-keys` 로 한 번 만들어 두 값을 그대로 넣는다.
# 비어 있으면 구독 등록은 되지만 발송이 전부 실패(FAILED)로 남는다
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# VAPID subject. 운영자 연락처 (mailto:ops@example.com 또는 서비스 https URL)
VAPID_SUBJECT=
