# Stagelog 백엔드 환경변수. 이름과 설명만 두고 값은 비운다 (실제 값은 .env 에, git 제외).
# local 프로파일은 이 파일을 복사한 .env 를 자동으로 읽는다 (application-local.yml 의 spring.config.import).
# 빈 값(NAME=)은 yml 기본값을 빈 문자열로 덮어쓴다. 기본값이 있는 변수는 주석(# NAME=)으로 두었으니 바꿀 때만 주석을 푼다.

# ---- 앱 ----
# 프론트 출처 (스킴+호스트[+포트], 경로·끝 / 없이. 예: https://stagelog.xx). 로그인 콜백 리다이렉트 대상이자
# CORS 허용 출처다. 정확히 일치하는 출처 하나만 허용하고 리프레시 쿠키를 위해 credentials 를 허용한다 (기본값 http://localhost:3000)
# STAGELOG_FRONT_URL=
# 이 API 서버의 공개 기본 주소. 유튜브 OAuth 콜백 redirect_uri ({API_BASE}/api/v1/admin/youtube/callback) 에 쓴다 (기본값 http://localhost:8080)
# STAGELOG_API_BASE_URL=
# 액세스 토큰 서명 비밀키 (HS256, 32바이트 이상)
STAGELOG_JWT_SECRET=

# ---- DB·Redis (develop/prod 프로파일 전용. local 은 docker-compose 값을 쓴다) ----
# jdbc:mysql://<host>:3306/stagelog?connectionTimeZone=UTC&forceConnectionTimeZoneToSession=true 형태
DB_URL=
# RDS 사용자
DB_USERNAME=
# RDS 비밀번호
DB_PASSWORD=
# Redis 호스트
REDIS_HOST=
# Redis 포트 (기본값 6379)
# REDIS_PORT=
# Redis 비밀번호 (선택, 비우면 인증 없음)
REDIS_PASSWORD=

# ---- 인증 (소셜 로그인) ----
# 네이버 OAuth2 클라이언트 ID (개발자센터 발급값)
NAVER_CLIENT_ID=
# 네이버 OAuth2 클라이언트 시크릿
NAVER_CLIENT_SECRET=
# 구글 OAuth2 클라이언트 ID (Cloud Console 발급값)
GOOGLE_CLIENT_ID=
# 구글 OAuth2 클라이언트 시크릿
GOOGLE_CLIENT_SECRET=

# ---- 출발지 검색·지오코딩 ----
# 카카오 로컬 API REST 키 (국내 시군구 출발지 검색). 비어 있으면 한글 검색도 LocationIQ 로 간다
KAKAO_REST_API_KEY=
# LocationIQ 토큰 (해외 도시 출발지 검색)
LOCATIONIQ_TOKEN=

# ---- AWS (S3·CloudFront) ----
# S3 리전 (기본값 ap-northeast-2). 자격증명은 AWS SDK 기본 체인(EC2 IAM 역할)을 쓰므로 키를 두지 않는다
# AWS_REGION=
# 포토카드·포스터·앨범커버 이미지 버킷 이름
AWS_S3_BUCKET=
# 이미지 공개 URL 의 CDN 기본 주소
CDN_BASE_URL=

# ---- 운영 알림 ----
# 디스코드 운영 알림 웹훅 URL (서버 설정 > 연동 > 웹훅). 비어 있으면 알림을 건너뛰고 로그만 남긴다
DISCORD_WEBHOOK_URL=

# ---- 번역 ----
# DeepL API 키 (Free 플랜 엔드포인트). 행사·공연장 이름 번역 초안에 쓴다. 비어 있으면 초안을 만들지 않는다
DEEPL_API_KEY=

# ---- setlist.fm ----
# setlist.fm API 키 (https://api.setlist.fm/docs). 셋리 병합·시드·행사 동기화에 쓴다
SETLISTFM_API_KEY=
# 대상 아티스트의 MusicBrainz 아티스트 ID. setlist.fm 아티스트 셋리 목록 조회에 쓴다
SETLISTFM_ARTIST_MBID=

# ---- YouTube ----
# 유튜브 재생목록 OAuth 클라이언트 ID (Cloud Console, YouTube Data API v3 활성화)
YOUTUBE_CLIENT_ID=
# 유튜브 재생목록 OAuth 클라이언트 시크릿
YOUTUBE_CLIENT_SECRET=
# 유튜브 리프레시 토큰 DB 암호화 키 (AES-256). `openssl rand -base64 32` 로 만든 값. 비어 있으면 평문으로 저장하고 기동 시 경고한다.
# 키를 바꾸면 기존 암호문을 읽지 못하므로 관리자가 채널을 다시 연결해야 한다
YOUTUBE_TOKEN_KEY=
# 재생목록 제목 앞머리 (보통 아티스트 이름). "{앞머리} {날짜} {공연장} 셋리" 로 만든다. 비어 있으면 앞머리 없이 만든다
YOUTUBE_PLAYLIST_TITLE_PREFIX=

# ---- 네이버 캘린더 (비공식) ----
# 대상 아티스트 일정을 올리는 네이버 공개 캘린더의 publishedKey. 공개 캘린더 페이지 URL 의 publishedKey 값을 넣는다.
# 코드 기본값이 없다. 비워 두면 동기화가 꺼지지 않고 빈 키로 네이버를 호출하므로 개발·운영 서버에는 반드시 넣는다
NAVER_CALENDAR_PUBLISHED_KEY=

# ---- KOPIS ----
# KOPIS(공연예술통합전산망) OpenAPI 서비스 키. 비어 있으면 KOPIS 보강을 건너뛴다
KOPIS_SERVICE_KEY=
# KOPIS 공연명 검색어 (대상 아티스트의 한글 이름). 비어 있으면 KOPIS 보강을 건너뛴다
KOPIS_ARTIST_KEYWORD=

# ---- Ticketmaster ----
# Ticketmaster Discovery API 키. 비어 있으면 Ticketmaster 동기화를 건너뛴다
TICKETMASTER_API_KEY=
# Ticketmaster 아티스트(attraction) 검색어. 이름이 정확히 같은(대소문자 무시) attraction 을 쓴다. 비어 있으면 동기화를 건너뛴다
TICKETMASTER_KEYWORD=
# 웹 푸시 VAPID 키 쌍(P-256, base64url). `npx web-push generate-vapid-keys` 로 한 번 만들어 두 값을 그대로 넣는다.
# 비어 있으면 구독 등록은 되지만 발송이 전부 실패(FAILED)로 남는다
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# VAPID subject. 운영자 연락처 (mailto:ops@example.com 또는 서비스 https URL)
VAPID_SUBJECT=
